config BR2_PACKAGE_ALT_F_UTILS
	bool "alt-f-utils"
	help
	  Device utilities inherited from Alt-F:
	  dns320l-daemon (Weltrend MCU: fan, RTC, power LED, power
	  button, shutdown/WOL), sysctrl (fan/temperature/button control)
	  and dns323-fw (D-Link firmware container tool).

if BR2_PACKAGE_ALT_F_UTILS

config BR2_PACKAGE_ALT_F_UTILS_SYSCTRL
	bool "sysctrl"
	help
	  Alt-F system control daemon. Not needed for the phase-1
	  test system; will be replaced by shareosd modules later.

endif
