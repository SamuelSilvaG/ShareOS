From: ShareOS <noreply@github.com>
Subject: [PATCH] proc: pass the Range header to CGI scripts (HTTP_RANGE)

The file a ShareOS app opens is served by a CGI script; audio and video
players ask for byte ranges to seek. uhttpd passes only a fixed list of
headers to scripts - add Range.

--- a/proc.c	2026-10-19 10:10:56.856570828 +0200
+++ b/proc.c	2026-10-19 10:10:56.870806178 +0200
@@ -37,7 +37,8 @@
 	__header(content_length, content-length) \
 	__header(x_http_method_override, x-http-method-override) \
 	__header(http_auth_user, http-auth-user) \
-	__header(http_auth_pass, http-auth-pass)
+	__header(http_auth_pass, http-auth-pass) \
+	__header(range, range)
 
 #undef __header
 #define __header __enum_header
@@ -70,6 +71,7 @@
 	{ "HTTP_X_HTTP_METHOD_OVERRIDE", HDR_x_http_method_override },
 	{ "HTTP_AUTH_USER", HDR_http_auth_user },
 	{ "HTTP_AUTH_PASS", HDR_http_auth_pass },
+	{ "HTTP_RANGE", HDR_range },
 	{ "CONTENT_TYPE", HDR_content_type },
 	{ "CONTENT_LENGTH", HDR_content_length },
 };
