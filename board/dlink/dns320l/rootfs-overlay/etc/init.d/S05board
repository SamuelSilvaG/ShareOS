#!/bin/sh
#
# ShareOS – DNS-320L board bring-up (phase 1)
#
# - LEDs and the Alt-F style /tmp/sys interface used by dns320l-daemon
# - dns320l-daemon: talks to the Weltrend MCU on /dev/ttyS1
#   (fan, temperature, power LED, RTC, power-off)
# - shareos-board: fan curve + power button polling
#

DAEMON=/usr/sbin/dns320l-daemon
PIDFILE=/var/run/dns320l-daemon.pid
BOARDPID=/var/run/shareos-board.pid

led() { [ -e "/sys/class/leds/$1/brightness" ] && echo "$2" > "/sys/class/leds/$1/brightness"; }

start() {
	printf "Starting board support: "

	mkdir -p /tmp/sys/power_led
	echo none > /tmp/sys/power_led/trigger
	echo 1    > /tmp/sys/power_led/brightness
	echo 100  > /tmp/sys/pwm1          # fan half speed until the first reading
	echo 0    > /tmp/sys/fan1_input

	led dns320l:red:sata0 0
	led dns320l:red:sata1 0
	led dns320l:orange:usb 0
	led dns320l:blue:usb 0
	# blue USB LED blinks while ShareOS is running
	[ -e /sys/class/leds/dns320l:blue:usb/trigger ] && \
		echo heartbeat > /sys/class/leds/dns320l:blue:usb/trigger

	if grep -q "DNS-320L" /proc/device-tree/model 2>/dev/null; then
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- -f
		start-stop-daemon -S -q -b -m -p "$BOARDPID" -x /usr/sbin/shareos-board
		echo "OK"
	else
		echo "not a DNS-320L, skipped"
	fi
}

stop() {
	printf "Stopping board support: "
	start-stop-daemon -K -q -p "$BOARDPID" 2>/dev/null
	start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
	sleep 1
	if [ -f /tmp/.poweroff ]; then
		# ask the MCU to cut power 3 seconds from now
		sync
		"$DAEMON" -x DeviceShutdown 3 >/dev/null 2>&1
		echo "power-off requested from MCU"
	else
		echo "OK"
	fi
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
