#!/bin/sh
#
# ShareOS – no known password on a new box.
#
# A box that still has the factory root password "shareos" and has not been
# set up (shareos.setup.done != 1) gets root locked at boot. The first
# access is "claiming": press the USB button on the front, then choose a
# password in the web interface (shareos.setup claim). SSH, the serial
# console and the browser terminal stay closed until then.
#
# Not touched: boxes with their own root password, the development boot over
# TFTP (shareos.netroot) and the rescue system (initramfs, has its own root).
#
[ "$1" = start ] || exit 0
grep -q 'shareos.netroot' /proc/cmdline 2>/dev/null && exit 0
[ "$(uci -q get shareos.setup.done)" = 1 ] && exit 0

h=$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow)
case "$h" in
	'$1$'*) m=md5 ;;
	'$5$'*) m=sha256 ;;
	'$6$'*) m=sha512 ;;
	*) exit 0 ;;                  # empty, locked or an unknown method
esac
salt=$(echo "$h" | cut -d'$' -f3)
[ "$(printf '%s' shareos | mkpasswd -P 0 -m "$m" -S "$salt" 2>/dev/null)" = "$h" ] || exit 0

sed -i 's/^root:[^:]*:/root:!:/' /etc/shadow &&
	logger -t shareos-claim "factory root password locked - claim the box with the USB button"
exit 0
