# ShareOS settings (UCI). Edit with: uci set shareos.update.channel=beta && uci commit shareos

config update 'update'
	# GitHub repository that publishes the firmware releases
	option repo 'UniqueDroid/ShareOS'
	# stable = releases only, beta = releases and pre-releases
	option channel 'stable'
	option api 'https://api.github.com'
	# 1 = look for a new release every 6 hours (shown in the web interface)
	option auto '1'

config ui 'ui'
	# 1 = show the ShareOS logo in the web interface, 0 = text only
	option logo '1'
	# language of the web interface for everyone: en, de, ... (www/i18n/)
	option lang 'en'
	# look for everyone: theme dark | light | system (follows the computer),
	# accent blue | green | red | white
	option theme 'dark'
	option accent 'blue'

config web 'web'
	# HTTPS on port 443 (a self-signed certificate is created on first boot)
	option https '1'
	# 1 = send http:// requests to https://
	option redirect '0'
	option cert '/etc/ssl/shareos/server.crt'
	option key '/etc/ssl/shareos/server.key'

config fan 'fan'
	# preset: quiet | balanced | cool | custom (then the temperatures below)
	option preset 'balanced'
	# °C: fan stops below off_temp (0 = never stops), runs full from full_temp,
	# drops back to half below half_temp
	option off_temp '0'
	option full_temp '50'
	option half_temp '45'

config led 'led'
	# blue USB LED: heartbeat | on | off
	option status 'heartbeat'
	# power LED: on | off | blink
	option power 'on'
	# red disk LEDs: off | activity
	option disks 'off'

config time 'time'
	# 1 = set the clock from the internet (NTP), 0 = by hand in the web interface
	option ntp '1'
	list server '0.pool.ntp.org'
	list server '1.pool.ntp.org'
	list server '2.pool.ntp.org'

config setup 'setup'
	# 0 = show the first-run wizard after the next login
	option done '0'

config autostart 'autostart'
	# services that are not started at boot (names as in /etc/init.d/S??<name>)
	#list disabled 'crond'

config widget 'widget'
	# 1 = /cgi-bin/status?token=… answers with a short JSON status (for widget
	# apps); a new token is created when it is switched on in the web interface
	option enabled '0'
	option token ''

config notify 'notify'
	# messages of the box (RAID, full volumes, temperature, SMART, updates,
	# failed cloud jobs and app tasks); always shown in the web interface
	option email '0'
	option smtp_host ''
	# starttls (port 587), ssl (port 465) or none
	option smtp_tls 'starttls'
	option smtp_port ''
	option smtp_user ''
	option smtp_pass ''
	option mail_from ''
	option mail_to ''
	# lowest level sent: info, warn or error
	option email_level 'warn'
	option push '0'
	# ntfy (https://ntfy.sh/<topic>), gotify (server address) or webhook (JSON POST)
	option push_type 'ntfy'
	option push_url ''
	option push_token ''
	option push_level 'warn'
	# limits for the checks
	option temp_max '55'
	option disk_full '90'
