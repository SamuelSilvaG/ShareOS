# ShareOS settings (UCI). Edit with: uci set shareos.update.channel=beta && uci commit shareos

config update 'update'
	# GitHub repository that publishes the firmware releases
	option repo 'UniqueDroid/ShareOS'
	# stable = releases only, beta = releases and pre-releases
	option channel 'stable'
	option api 'https://api.github.com'

config ui 'ui'
	# 1 = show the ShareOS logo in the web interface, 0 = text only
	option logo '1'
	# language of the web interface for everyone: en, de, ... (www/i18n/)
	option lang 'en'
	# look for everyone: theme dark | light | system (follows the computer),
	# accent blue | green | red | white
	option theme 'dark'
	option accent 'blue'

config web 'web'
	# HTTPS on port 443 (a self-signed certificate is created on first boot)
	option https '1'
	# 1 = send http:// requests to https://
	option redirect '0'
	option cert '/etc/ssl/shareos/server.crt'
	option key '/etc/ssl/shareos/server.key'

config fan 'fan'
	# preset: quiet | balanced | cool | custom (then the temperatures below)
	option preset 'balanced'
	# °C: fan stops below off_temp (0 = never stops), runs full from full_temp,
	# drops back to half below half_temp
	option off_temp '0'
	option full_temp '50'
	option half_temp '45'

config led 'led'
	# blue USB LED: heartbeat | on | off
	option status 'heartbeat'
	# power LED: on | off | blink
	option power 'on'
	# red disk LEDs: off | activity
	option disks 'off'

config setup 'setup'
	# 0 = show the first-run wizard after the next login
	option done '0'

config autostart 'autostart'
	# services that are not started at boot (names as in /etc/init.d/S??<name>)
	#list disabled 'crond'
