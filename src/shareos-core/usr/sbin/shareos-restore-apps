#!/bin/sh
#
# shareos-restore-apps – install the apps of a restored settings backup
#
# The ids are in /etc/shareos/recovery-apps (written by the recovery mode or
# the apps page). Apps are installed one after the other from the store; an
# app that fails stays in the list, so the apps page can offer it again.
#
#   SHAREOS_ROOT=<dir>  fake root (tests)   SHAREOS_APPS=<program> installer (tests)
#
[ -n "$SHAREOS_ROOT" ] || PATH=/usr/sbin:/usr/bin:/sbin:/bin
LIST=${SHAREOS_ROOT:-}/etc/shareos/recovery-apps
RUN=${SHAREOS_ROOT:-}/tmp/shareos-restore-apps.run
APPS=${SHAREOS_APPS:-shareos-apps}

[ -s "$LIST" ] || exit 0
if [ -f "$RUN" ] && [ -d "/proc/$(cat "$RUN")" ]; then
	echo "shareos-restore-apps: already running" >&2
	exit 1
fi
echo $$ > "$RUN"
# after a boot: wait a little for the network (the store is on the internet)
[ -n "$SHAREOS_ROOT" ] || for i in $(seq 30); do ip route 2>/dev/null | grep -q '^default' && break; sleep 2; done
trap 'rm -f "$RUN"' EXIT
for id in $(cat "$LIST"); do
	case "$id" in *[!a-z0-9-]*|'') continue ;; esac
	if $APPS install "$id" >/dev/null 2>&1; then
		logger -t shareos-restore-apps "$id installed" 2>/dev/null
		grep -vx "$id" "$LIST" > "$LIST.new"; mv "$LIST.new" "$LIST"
	else
		logger -t shareos-restore-apps "$id failed" 2>/dev/null
	fi
done
[ -s "$LIST" ] || rm -f "$LIST"
