#!/bin/sh
#
# shareos-net – network of the box (eth0) from UCI /etc/config/network
#
#   shareos-net start | stop | restart
#   shareos-net apply [seconds]   restart with the new settings; if nobody
#                                 confirms within the time (default 120 s),
#                                 the previous settings come back
#   shareos-net confirm           keep the new settings
#
# DHCP without an answer: the box takes the fallback address
# (network.lan.fallback, default 192.168.0.32 like D-Link's firmware) so it
# can be reached directly from a PC, and keeps asking for DHCP every 30 s.
#
# Before "apply", the caller copies the old /etc/config/network to
# /etc/shareos/network.rollback. State for the web interface is kept in
# /tmp/shareos-net (pending, result).
#
PATH=${SHAREOS_TEST_PATH:+$SHAREOS_TEST_PATH:}/usr/sbin:/usr/bin:/sbin:/bin
ROOT=${SHAREOS_ROOT:-}
CONF=$ROOT/etc/config/network
IFACES=$ROOT/etc/network/interfaces
RESOLV=$ROOT/etc/resolv.conf
ROLLBACK=$ROOT/etc/shareos/network.rollback
ST=$ROOT/tmp/shareos-net
IF=eth0
FBPID=$ROOT/run/shareos-net-fallback.pid

log() { logger -t shareos-net "$*"; echo "$*"; }

get() { uci -q ${ROOT:+-c $ROOT/etc/config} get network.lan.$1; }

write_config() {
	proto=$(get proto)
	mkdir -p "$(dirname "$IFACES")"
	{
		echo "# written by shareos-net from /etc/config/network – edit there"
		echo "auto lo"
		echo "iface lo inet loopback"
		echo
		echo "auto $IF"
		if [ "$proto" = static ]; then
			echo "iface $IF inet static"
			echo "  address $(get ipaddr)"
			echo "  netmask $(get netmask)"
			gw=$(get gateway); [ -n "$gw" ] && echo "  gateway $gw"
		else
			echo "iface $IF inet dhcp"
			echo "  pre-up /etc/network/nfs_check"
			echo "  wait-delay 15"
			echo "  hostname \$(hostname)"
		fi
	} > "$IFACES.new" && mv "$IFACES.new" "$IFACES"
}

write_resolv() {
	[ "$(get proto)" = static ] || return 0
	dns=$(get dns)
	[ -n "$dns" ] || dns=$(get gateway)
	: > "$RESOLV.new"
	for d in $dns; do echo "nameserver $d" >> "$RESOLV.new"; done
	cat "$RESOLV.new" > "$RESOLV"; rm -f "$RESOLV.new"
}

has_ip() { ip -4 -o addr show dev $IF 2>/dev/null | grep -v " $IF:fb" | grep -q ' inet '; }

fallback_ip() {
	f=$(get fallback 2>/dev/null) || f=192.168.0.32
	case "$f" in off|none|0|'') ;; *) echo "${f%%/*}" ;; esac
}

fallback_up() {
	fb=$(fallback_ip)
	[ -n "$fb" ] || return 0
	ip link set $IF up
	ip addr add "$fb/24" dev $IF label $IF:fb 2>/dev/null
	log "no answer from a DHCP server – reachable at $fb, still asking for DHCP"
	start-stop-daemon -S -b -m -p $FBPID -x /bin/sh -- "$0" watch
}

fallback_down() {
	[ -f $FBPID ] && kill "$(cat $FBPID)" 2>/dev/null
	rm -f $FBPID
	fb=$(fallback_ip)
	[ -n "$fb" ] && ip addr del "$fb/24" dev $IF 2>/dev/null
	return 0
}

# ask for DHCP now and then; once a server answers, start over with it
watch() {
	while sleep 30; do
		[ "$(get proto)" = static ] && exit 0
		if udhcpc -n -q -t 2 -T 3 -i $IF -s /bin/true >/dev/null 2>&1; then
			log "a DHCP server answers – leaving the fallback address"
			rm -f $FBPID
			fb=$(fallback_ip); [ -n "$fb" ] && ip addr del "$fb/24" dev $IF 2>/dev/null
			ifdown $IF 2>/dev/null; ifup $IF
			# the self-signed certificate names the address
			shareos-cert ensure 2>/dev/null | grep -q renewed && { killall uhttpd 2>/dev/null; sleep 2; /etc/init.d/S51apps start >/dev/null 2>&1; }
			exit 0
		fi
	done
}

start() {
	mkdir -p $ROOT/run/network
	write_config
	ifup -a
	rc=$?
	write_resolv
	if [ "$(get proto)" != static ] && ! has_ip; then fallback_up; rc=0; fi
	return $rc
}

stop() {
	fallback_down
	ifdown -a 2>/dev/null
	# take down what ifdown might have missed (e.g. an address set by hand)
	ip addr flush dev $IF 2>/dev/null
	return 0
}

apply() {
	timeout=${1:-120}
	mkdir -p $ST
	rm -f $ST/confirmed $ST/result
	echo "$(( $(date +%s) + timeout ))" > $ST/pending
	# let the web request that started this get its answer first
	sleep 2
	log "applying new network settings ($(get proto) $(get ipaddr)), confirm within $timeout s"
	stop; start
	end=$(( $(date +%s) + timeout ))
	while [ "$(date +%s)" -lt "$end" ]; do
		if [ -e $ST/confirmed ]; then
			rm -f $ST/pending $ST/confirmed "$ROLLBACK"
			echo ok > $ST/result
			log "new network settings confirmed"
			return 0
		fi
		sleep 1
	done
	log "no confirmation – restoring the previous network settings"
	if [ -s "$ROLLBACK" ]; then
		cp "$ROLLBACK" "$CONF" && rm -f "$ROLLBACK"
	fi
	stop; start
	rm -f $ST/pending
	echo rolledback > $ST/result
	return 1
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	apply) apply "$2" ;;
	confirm) [ -e $ST/pending ] && touch $ST/confirmed ;;
	watch) watch ;;
	*) sed -n '3,18s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
