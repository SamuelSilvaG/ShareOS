#!/bin/sh
#
# shareos-shares – SMB (ksmbd) and NFS shares from UCI /etc/config/shares
#
#   shareos-shares apply     create missing folders, write the ksmbd and NFS
#                            configuration, (re)start or reload the services
#   shareos-shares start | stop
#   shareos-shares status    key=value lines for the web interface
#   shareos-shares vault-unlock <share> <user> <minutes>
#   shareos-shares vault-lock <share> [<user>]
#   shareos-shares vault-expire     lock what ran out (cron, every minute)
#   shareos-shares vault-status     vault=<share>:<user>:<until (epoch)>
#
# Access: SMB checks users and groups per share (valid/read/write lists).
# The same rights are set as POSIX ACLs on the folder and everything in it
# (rwX for write, r-X for read, nothing for everybody else; default ACLs for
# new files), so every program of a user – SMB, apps, Transmission, cloud
# jobs – is held to them by Linux. Drives without Linux rights (exFAT, NTFS,
# FAT) only have the checks of SMB and the web interface. NFS has no
# accounts: clients are listed by address/network and act as nobody.
#
# Vault (option vault '1', discussion #88): the share is locked by default –
# not exported over SMB, never over NFS or to guests. A user with rights on
# it unlocks it for some minutes (web interface or the app SDK, after
# entering the password again): then it is exported for the users who
# unlocked it only, and locked again when the time runs out (cron). While
# locked, the top folder's ACL lets nobody but root in, so open SMB
# connections and the user's programs lose access too (on drives with Linux
# rights). The unlock state lives in /tmp: a restart locks everything.
#
PATH=/usr/sbin:/usr/bin:/sbin:/bin
SMBCONF=/etc/ksmbd/ksmbd.conf
SMBPROTO=/tmp/shareos-shares.smbcompat   # compatibility mode ksmbd was started with
ACLSTATE=/etc/shareos/share-acl
EXPORTS=/etc/exports
AVAHI_SMB=/etc/avahi/services/smb.service
VAULT=/tmp/shareos-vault                 # <share>: lines "<user> <until>"

log() { logger -t shareos-shares "$*"; echo "$*"; }

shares() { uci -q show shares | sed -n "s/^shares\.\([^.=]*\)=share$/\1/p"; }
get() { uci -q get shares."$1"."$2"; }
on() { [ "$(get "$1" "$2")" = 1 ]; }
global() { uci -q get shares.global."$1"; }

share_path() {   # name -> absolute path (or nothing when the volume is unknown)
	v=$(get "$1" volume)
	[ -n "$v" ] && [ "$(uci -q get storage."$v")" = volume ] || return 1
	p=$(get "$1" path); [ -n "$p" ] || p=$1
	case "$p" in /*|*..*) return 1 ;; esac
	echo "/mnt/$v/$p"
}
volume_mounted() { grep -q " /mnt/$1 " /proc/mounts; }

# --- vault ---
vault() { on "$1" vault; }
now() { date +%s; }
# users who unlocked the share and whose time has not run out (one per line)
vault_users() {   # share
	[ -f "$VAULT/$1" ] || return 0
	t=$(now)
	while read -r u until; do [ -n "$u" ] && [ "${until:-0}" -gt "$t" ] && echo "$u"; done < "$VAULT/$1"
}
# access of a user to a share from its lists: rw, ro or nothing
user_access() {   # share user
	acc=
	for g in "$2" $(id -Gn "$2" 2>/dev/null | tr ' ' '\n' | sed 's/^/@/'); do
		for x in $(get "$1" rw); do [ "$x" = "$g" ] && { echo rw; return 0; }; done
		for x in $(get "$1" ro); do [ "$x" = "$g" ] && acc=ro; done
	done
	[ -n "$acc" ] && echo "$acc"
	return 0
}
# the top folder of a vault: only root and the users who unlocked it (not
# recursive – the folders inside keep the share's ACL); remembered in
# $ACLSTATE/<share>.vault so switching the vault off restores the share's ACL
vault_gate() {   # share path
	command -v setfacl >/dev/null || return 0
	spec='u::rwx,g::---,o::---'
	for u in $(vault_users "$1"); do
		case "$(user_access "$1" "$u")" in
			rw) spec="$spec,u:$u:rwx" ;;
			ro) spec="$spec,u:$u:r-x" ;;
		esac
	done
	setfacl --set "$spec,m::rwx" "$2" 2>/dev/null || return 0
	mkdir -p "$ACLSTATE" && : > "$ACLSTATE/$1.vault"
}

ensure_folder() {   # path
	[ -d "$1" ] && return 0
	mkdir -p "$1" && chown root:users "$1" && chmod 2775 "$1"
}

# ACL of a share: owner (creator) full, owning group and others nothing,
# named entries from the rights; nobody for guest reading and NFS
acl_spec() {   # share
	spec='u::rwX,g::---,o::---' nob=
	for x in $(get "$1" rw); do acl_entry "$x" rwX; done
	for x in $(get "$1" ro); do acl_entry "$x" r-X; done
	if ! vault "$1"; then
		on "$1" guest && nob=r-X
		if on "$1" nfs && [ -n "$(get "$1" nfs_hosts)" ]; then on "$1" nfs_rw && nob=rwX || nob=${nob:-r-X}; fi
	fi
	[ -n "$nob" ] && spec="$spec,u:nobody:$nob"
	echo "$spec,m::rwX"
}
acl_entry() {   # user|@group perms
	case "$1" in
		@*) grep -q "^${1#@}:" /etc/group && spec="$spec,g:${1#@}:$2" ;;
		*) id -u "$1" >/dev/null 2>&1 && spec="$spec,u:$1:$2" ;;
	esac
}
# set the ACL on a share folder (in the background: big folders take long);
# only when the rights changed since the last time
apply_acl() {   # share path
	command -v setfacl >/dev/null || return 0
	# never over the personal folders, the apps area or the snapshots
	case "$2" in /mnt/*/home|/mnt/*/home/*|/mnt/*/.shareos*|/mnt/*/Snapshots|/mnt/*/Snapshots/*)
		log "share $1: folder $2 keeps its own rights (no ACL)"; return 0 ;; esac
	spec=$(acl_spec "$1")
	[ "$(cat "$ACLSTATE/$1" 2>/dev/null)" = "$spec $2" ] && return 0
	mkdir -p "$ACLSTATE"
	# a drive without Linux rights: nothing to do (and nothing to remember)
	setfacl --set "$spec" "$2" 2>/dev/null || { log "share $1: no ACLs on this drive (only SMB and the web interface check the rights)"; return 0; }
	(
		# --set replaces the whole ACL: rights taken away are gone everywhere
		nice -n 19 setfacl -R --set "$spec" "$2" 2>/dev/null
		find "$2" -type d -exec nice -n 19 setfacl -d --set "$(echo "$spec" | tr X x)" {} + 2>/dev/null
		echo "$spec $2" > "$ACLSTATE/$1"
		# --set -R also opened the top folder of a vault: close it again
		vault "$1" && vault_gate "$1" "$2"
	) </dev/null >/dev/null 2>&1 &
	[ "${SHAREOS_ACL_WAIT:-0}" = 1 ] && wait
	return 0
}

# list of users/@groups for ksmbd (space separated)
acl_list() { for x in $(get "$1" "$2"); do printf '%s ' "$x"; done; }

write_smb() {
	mkdir -p /etc/ksmbd
	host=$(cat /proc/sys/kernel/hostname)
	{
		echo "; written by shareos-shares from /etc/config/shares – edit there"
		echo "[global]"
		echo "	workgroup = $(global workgroup || echo WORKGROUP)"
		echo "	server string = ShareOS"
		echo "	netbios name = $host"
		echo "	map to guest = bad user"
		echo "	guest account = nobody"
		echo "	server min protocol = SMB2_10"
		# compatibility mode: at most SMB 2.1. Clients that must sign (Windows
		# 11) then sign with HMAC-SHA256 (ARM assembly in the kernel) instead
		# of AES-CMAC: about twice as fast on the 800 MHz Kirkwood (#94)
		[ "$(global smb_compat)" = 1 ] && echo "	server max protocol = SMB2_10"
		echo "	smb2 leases = yes"
		# home folders: \\box\<user> for the logged-in user only
		if uci -q show accounts | grep -q "\.home='[^']\+'"; then
			echo
			echo "[homes]"
			echo "	comment = personal folder"
			echo "	path = %H"
			echo "	read only = no"
			echo "	browseable = no"
			echo "	guest ok = no"
			echo "	create mask = 0600"
			echo "	directory mask = 0700"
			echo "	vfs objects = streams_xattr"
		fi
		for s in $(shares); do
			on "$s" smb || continue
			p=$(share_path "$s") || continue
			v=$(get "$s" volume); volume_mounted "$v" || continue
			rw=$(acl_list "$s" rw); ro=$(acl_list "$s" ro)
			# vault: only while unlocked, only for the users who unlocked it
			vu=
			if vault "$s"; then
				for u in $(vault_users "$s"); do [ -n "$(user_access "$s" "$u")" ] && vu="$vu$u "; done
				[ -n "$vu" ] || continue
			fi
			echo
			echo "[$s]"
			c=$(get "$s" comment); [ -n "$c" ] && echo "	comment = $c"
			echo "	path = $p"
			echo "	read only = yes"
			echo "	browseable = yes"
			if [ -n "$vu" ]; then
				echo "	guest ok = no"
				echo "	valid users = $vu"
			elif on "$s" guest; then
				echo "	guest ok = yes"
			else
				echo "	guest ok = no"
				echo "	valid users = $rw$ro"
			fi
			[ -n "$rw" ] && echo "	write list = $rw"
			[ -n "$ro" ] && echo "	read list = $ro"
			echo "	force group = users"
			echo "	create mask = 0664"
			echo "	directory mask = 2775"
			# named streams (kept as xattrs): without them the Files app of
			# iOS 18 and newer shows the share read-only (#112); not on file
			# systems without user xattrs (FAT, exFAT, NTFS volumes)
			case "$(uci -q get storage."$v".fstype)" in vfat|exfat|ntfs) ;; *) echo "	vfs objects = streams_xattr" ;; esac
		done
	} > $SMBCONF.new && mv $SMBCONF.new $SMBCONF
}

write_nfs() {
	{
		echo "# written by shareos-shares from /etc/config/shares – edit there"
		for s in $(shares); do
			on "$s" nfs || continue
			vault "$s" && continue   # NFS has no accounts: a vault is never exported
			p=$(share_path "$s") || continue
			volume_mounted "$(get "$s" volume)" || continue
			mode=ro; on "$s" nfs_rw && mode=rw
			hosts=$(get "$s" nfs_hosts)
			[ -n "$hosts" ] || continue
			line="$p"
			for h in $hosts; do line="$line $h($mode,sync,no_subtree_check,all_squash,anonuid=65534,anongid=100)"; done
			echo "$line"
		done
	} > $EXPORTS.new && mv $EXPORTS.new $EXPORTS
}

smb_wanted() { [ "$(global smb || echo 1)" = 1 ] && grep -q '^\[' $SMBCONF 2>/dev/null && [ "$(grep -c '^\[' $SMBCONF)" -gt 1 -o -n "$(grep '^\[homes\]' $SMBCONF)" ]; }
nfs_wanted() { [ "$(global nfs || echo 1)" = 1 ] && grep -q '^/' $EXPORTS 2>/dev/null; }

smb_start() {
	# the Kirkwood crypto engine (CESA) computes the AES-CMAC signatures of
	# large SMB 3 messages (kernel patch 0001-ksmbd-cmac-via-cbc, #94)
	modprobe marvell-cesa 2>/dev/null
	modprobe ksmbd 2>/dev/null
	# a mountd left over without the kernel module serves nobody
	if pidof ksmbd.mountd >/dev/null; then
		[ -d /sys/module/ksmbd ] && return 0
		killall ksmbd.mountd 2>/dev/null; sleep 1
		modprobe ksmbd 2>/dev/null
	fi
	ksmbd.mountd >/dev/null 2>&1 || log "ksmbd.mountd failed"
}
smb_stop() {
	pidof ksmbd.mountd >/dev/null || return 0
	ksmbd.control -s >/dev/null 2>&1
	sleep 1
	killall ksmbd.mountd 2>/dev/null
	rmmod ksmbd 2>/dev/null
}
smb_reload() { ksmbd.control -r >/dev/null 2>&1 || { smb_stop; smb_start; }; }

# announce the SMB server in the network (Finder, Linux file managers)
smb_announce() {   # 1 | 0
	[ -d "${AVAHI_SMB%/*}" ] || return 0
	if [ "$1" = 1 ]; then
		[ -f $AVAHI_SMB ] && return 0
		cat > $AVAHI_SMB <<'X'
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service><type>_smb._tcp</type><port>445</port></service>
</service-group>
X
	else
		[ -f $AVAHI_SMB ] || return 0
		rm -f $AVAHI_SMB
	fi
	avahi-daemon -r >/dev/null 2>&1
	return 0
}

nfs_start() {
	modprobe nfsd 2>/dev/null
	# rpcbind and nfs are started here, not at boot (post-build renames them)
	[ -x /etc/init.d/rpcbind ] && ! pidof rpcbind >/dev/null && /etc/init.d/rpcbind start >/dev/null 2>&1
	if ! pidof rpc.mountd >/dev/null; then
		[ -x /etc/init.d/nfs ] && /etc/init.d/nfs start >/dev/null 2>&1
	fi
	exportfs -ra 2>/dev/null
}
nfs_stop() {
	[ -x /etc/init.d/nfs ] && pidof rpc.mountd >/dev/null && /etc/init.d/nfs stop >/dev/null 2>&1
	return 0
}

cmd_apply() {
	[ -f /etc/config/shares ] || : > /etc/config/shares
	for s in $(shares); do
		p=$(share_path "$s") || continue
		volume_mounted "$(get "$s" volume)" && ensure_folder "$p" || continue
		# a share that is no vault any more: set its full ACL again
		if ! vault "$s" && [ -f "$ACLSTATE/$s.vault" ]; then rm -f "$ACLSTATE/$s" "$ACLSTATE/$s.vault"; fi
		apply_acl "$s" "$p"
		vault "$s" && vault_gate "$s" "$p"
	done
	write_smb
	write_nfs
	if smb_wanted; then
		# the protocol range is read only when ksmbd starts: restart on a change
		proto=$(global smb_compat || echo 0)
		if pidof ksmbd.mountd >/dev/null && [ "$(cat $SMBPROTO 2>/dev/null || echo 0)" != "$proto" ]; then smb_stop; fi
		pidof ksmbd.mountd >/dev/null && smb_reload || smb_start
		echo "$proto" > $SMBPROTO
		smb_announce 1
	else smb_stop; smb_announce 0; fi
	if nfs_wanted; then nfs_start; else nfs_stop; fi
	return 0
}

cmd_status() {
	echo "smb=$(pidof ksmbd.mountd >/dev/null && echo 1 || echo 0)"
	echo "nfs=$(pidof rpc.mountd >/dev/null && echo 1 || echo 0)"
	for s in $(shares); do
		p=$(share_path "$s") || { echo "share=$s:"; continue; }
		v=$(get "$s" volume)
		echo "share=$s:$p:$(volume_mounted "$v" && echo 1 || echo 0)"
	done
}

valid_share() { echo "$1" | grep -qE '^[a-z0-9][a-z0-9_-]{0,15}$' && [ "$(uci -q get shares."$1")" = share ]; }

cmd_vault_unlock() {   # share user minutes
	valid_share "$1" && vault "$1" || { echo "error: not a vault"; return 1; }
	echo "$2" | grep -qE '^[a-z][a-z0-9_]{0,31}$' && id -u "$2" >/dev/null 2>&1 || { echo "error: unknown user"; return 1; }
	[ -n "$(user_access "$1" "$2")" ] || { echo "error: no access to this share"; return 1; }
	echo "$3" | grep -qE '^[0-9]+$' && [ "$3" -ge 1 ] && [ "$3" -le 480 ] || { echo "error: invalid time (1–480 minutes)"; return 1; }
	p=$(share_path "$1") && volume_mounted "$(get "$1" volume)" || { echo "error: the drive is not mounted"; return 1; }
	mkdir -p "$VAULT" && chmod 700 "$VAULT"
	until=$(( $(now) + $3 * 60 ))
	{ grep -v "^$2 " "$VAULT/$1" 2>/dev/null; echo "$2 $until"; } > "$VAULT/$1.new" && mv "$VAULT/$1.new" "$VAULT/$1"
	log "vault $1 unlocked for $2 until $(date -d "@$until" '+%H:%M' 2>/dev/null || echo "$until")"
	vault_gate "$1" "$p"
	write_smb
	smb_wanted && { pidof ksmbd.mountd >/dev/null && smb_reload || smb_start; smb_announce 1; }
	echo "until=$until"
}

# lock a vault for one user or everyone; open SMB connections lose access
# through the folder's ACL, the export disappears with the reload
vault_close() {   # share [user]
	if [ -n "$2" ]; then
		[ -f "$VAULT/$1" ] && grep -v "^$2 " "$VAULT/$1" > "$VAULT/$1.new"; mv "$VAULT/$1.new" "$VAULT/$1" 2>/dev/null
		[ -s "$VAULT/$1" ] || rm -f "$VAULT/$1"
	else rm -f "$VAULT/$1"; fi
	p=$(share_path "$1") && volume_mounted "$(get "$1" volume)" && vault_gate "$1" "$p"
	return 0
}
cmd_vault_lock() {   # share [user]
	valid_share "$1" && vault "$1" || { echo "error: not a vault"; return 1; }
	vault_close "$1" "$2"
	log "vault $1 locked${2:+ for $2}"
	write_smb
	pidof ksmbd.mountd >/dev/null && smb_reload
	return 0
}

cmd_vault_expire() {
	[ -d "$VAULT" ] || return 0
	changed=
	for f in "$VAULT"/*; do
		[ -f "$f" ] || continue
		s=${f##*/}
		case "$s" in *.new) continue ;; esac
		if ! valid_share "$s" || ! vault "$s"; then rm -f "$f"; changed=1; continue; fi
		left=$(vault_users "$s")
		[ "$(grep -c . "$f")" = "$(echo "$left" | grep -c .)" ] && continue
		t=$(now)
		while read -r u until; do [ -n "$u" ] && [ "${until:-0}" -gt "$t" ] && echo "$u $until"; done < "$f" > "$f.new"
		if [ -s "$f.new" ]; then mv "$f.new" "$f"; else rm -f "$f" "$f.new"; fi
		log "vault $s: time ran out${left:+ (still open for $(echo $left))}"
		p=$(share_path "$s") && volume_mounted "$(get "$s" volume)" && vault_gate "$s" "$p"
		changed=1
	done
	if [ -n "$changed" ]; then write_smb; pidof ksmbd.mountd >/dev/null && smb_reload; fi
	return 0
}

cmd_vault_status() {
	for s in $(shares); do
		vault "$s" || continue
		[ -f "$VAULT/$s" ] || continue
		t=$(now)
		while read -r u until; do [ -n "$u" ] && [ "${until:-0}" -gt "$t" ] && echo "vault=$s:$u:$until"; done < "$VAULT/$s"
	done
	return 0
}

case "$1" in
	apply) cmd_apply ;;
	vault-unlock) cmd_vault_unlock "$2" "$3" "$4" ;;
	vault-lock) cmd_vault_lock "$2" "$3" ;;
	vault-expire) cmd_vault_expire ;;
	vault-status) cmd_vault_status ;;
	start) cmd_apply ;;
	stop) smb_stop; nfs_stop ;;
	status) cmd_status ;;
	*) sed -n '3,18s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
